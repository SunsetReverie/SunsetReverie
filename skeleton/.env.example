# ───────── 应用 ─────────
APP_NAME={{APP_NAME}}
APP_ENV=local                    # local | test | staging | production
APP_DEBUG=true                   # 生产环境必须为 false
APP_KEY=                         # sr new 时自动生成
APP_TIMEZONE=Asia/Shanghai

# ───────── 数据库 ─────────
DB_CONNECTION=mysql              # mysql | pgsql | sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=root
DB_PASSWORD=

# ───────── 缓存 ─────────
CACHE_DRIVER=file                # array | file
CACHE_PREFIX=sr:
CACHE_TTL=3600
