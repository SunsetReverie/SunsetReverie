# PHPStan 配置
#
# level 从 6 起步：直接上 8 会一次报上千条，分批修更可控。
# 每修完一批就把 level 调高一级，直到 8。
parameters:
    level: 6

    paths:
        - core
        - components
        - tests

    excludePaths:
        analyse:
            - vendor/*
            - skeleton/*
            - docs/*

    # 允许在类未加载时继续分析（框架大量使用运行期注册）
    treatPhpDocTypesAsCertain: false

    # 忽略的错误必须写明理由，不允许无声忽略
    ignoreErrors: []
