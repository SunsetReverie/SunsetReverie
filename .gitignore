# ─────────────────────────────────────────────
# 夕梦框架 SunsetReverie · 框架仓库忽略规则
# 说明：本仓库是「框架本体」，不含业务代码与运行期产物。
#       业务项目（如 xi-blog）有自己的 .gitignore。
# ─────────────────────────────────────────────

# 操作系统
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# 编辑器 / IDE
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# 依赖（框架核心零运行时依赖，仅开发工具可能产生）
/vendor/
/node_modules/
composer.lock

# 日志与临时文件
*.log
/tmp/
*.cache

# 本地环境与密钥（绝不入库）
.env
.env.*.local
*.pem
*.key
!docs/**/*.key

# 运行期产物（框架仓库不应出现，此处兜底防误提交）
/storage/logs/
/storage/cache/
/storage/compiled/
/storage/uploads/

# 测试与覆盖率产物
/tests/coverage/
.phpunit.result.cache
.php-cs-fixer.cache
build/

# 构建与发布中间产物
/dist/
*.tar.gz
*.zip
!skeleton/**/*.zip

# PHPStan 单文件（开发工具，不入库）
/phpstan.phar
