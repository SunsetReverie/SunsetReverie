# ───────── 应用 ─────────
APP_NAME={{APP_NAME}}
APP_ENV=local                    # local | test | staging | production
APP_DEBUG=true                   # 生产环境必须为 false
APP_KEY=                         # sr new 时自动生成
APP_TIMEZONE=Asia/Shanghai

# ───────── 数据库 ─────────
DB_CONNECTION=mysql              # mysql | pgsql | sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app                    # sqlite 驱动忽略此项
DB_SQLITE_DATABASE=storage/database.sqlite   # 仅 sqlite 使用（相对项目根）
DB_TIMEOUT=5                       # 连接/读写超时（秒）
DB_USERNAME=root
DB_PASSWORD=

# ───────── 认证 ─────────
AUTH_GUARD=jwt
JWT_SECRET=                      # sr jwt:secret 生成（≥32 字节）
JWT_TTL=7200

# ───────── 上传 ─────────
UPLOAD_DISK=local
UPLOAD_MAX_SIZE=10485760         # 10 MB
UPLOAD_SIGN_SECRET=              # 私有文件签名 URL 密钥（≥32 字节）

# ───────── 缓存 ─────────
CACHE_DRIVER=file                 # file | redis | apcu | array
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=1.5
CACHE_PREFIX=sr:
CACHE_TTL=3600

# ───────── 邮件 ─────────
MAIL_MAILER=log                  # log（只写日志）| smtp（真发）
MAIL_HOST=127.0.0.1              # QQ: smtp.qq.com / 163: smtp.163.com / Gmail: smtp.gmail.com
MAIL_PORT=1025                   # 明文 25/1025 | STARTTLS 587 | SMTPS 465
MAIL_ENCRYPTION=                 # 空=明文 | tls=STARTTLS(587) | ssl=SMTPS(465)
MAIL_USERNAME=
MAIL_PASSWORD=                   # QQ/163 用「授权码」，不是登录密码
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=夕梦
MAIL_VERIFY_PEER=true            # 只有内网自签证书才设 false
MAIL_TIMEOUT=10
